{
  "expo": {
    "name": "Weir Here",
    "slug": "weir-here",
    "version": "1.0.0",
    "scheme": "weirhere",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1929"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weirhere.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1929"
      },
      "package": "com.weirhere.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
