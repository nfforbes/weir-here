{
  "name": "@weir-here/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "dev": "next dev -p 3000",
    "dev:webpack": "next dev -p 3000",
    "dev:https": "next dev -p 3000 --experimental-https",
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.15.0",
    "@azure/identity": "^4.4.0",
    "@emotion/cache": "^11.13.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/material-nextjs": "^6.4.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@weir-here/shared": "*",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "mongoose": "^8.9.0",
    "multiparty": "^4.3.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "redux-saga": "^1.3.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "sharp": "^0.33.5",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0"
  }
}
