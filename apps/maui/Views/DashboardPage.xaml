<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeirHere.Maui.ViewModels"
             x:Class="WeirHere.Maui.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="{Binding StatusText}" />
        <Button Text="Sign out" Command="{Binding LogoutCommand}" />
    </VerticalStackLayout>
</ContentPage>
