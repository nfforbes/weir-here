<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeirHere.Maui.ViewModels"
             xmlns:models="clr-namespace:WeirHere.Maui.Models"
             x:Class="WeirHere.Maui.Views.JobsPage"
             x:DataType="vm:JobsViewModel"
             Title="Jobs">
    <Grid RowDefinitions="Auto,*" Padding="8">
        <Label Grid.Row="0" Text="{Binding StatusText}" Margin="8,0" />
        <RefreshView Grid.Row="1" Command="{Binding LoadJobsCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Jobs}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Job">
                        <Frame Padding="12" Margin="4" BorderColor="Gray">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Location}" FontSize="12" TextColor="Gray" />
                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="View"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenJobCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
