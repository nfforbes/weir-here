<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeirHere.Maui.ViewModels"
             x:Class="WeirHere.Maui.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Weir Here">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Weir Here" FontSize="28" HorizontalOptions="Center" />
        <Button Text="I need talent (Job board)" Command="{Binding GoToJobsCommand}" />
        <Button Text="I need a career (Dashboard)" Command="{Binding GoToDashboardCommand}" />
        <Button Text="Sign in" Command="{Binding GoToLoginCommand}" />
    </VerticalStackLayout>
</ContentPage>
