<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeirHere.Maui.ViewModels"
             x:Class="WeirHere.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Sign in">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="{Binding StatusText}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Sign in with Auth0" Command="{Binding LoginCommand}" />
    </VerticalStackLayout>
</ContentPage>
