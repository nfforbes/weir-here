# Auth0 — variable names must match apps/web/src/lib/auth0.ts (not AUTH0_BASE_URL)
# Use https:// when running `next dev` with --experimental-https
AUTH0_SECRET=use-openssl-rand-hex-32
APP_BASE_URL=https://localhost:3000
AUTH0_DOMAIN=YOUR_DOMAIN.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=from-auth0-application-settings

# MongoDB
MONGODB_URI=mongodb://localhost:27017/weir-here

# Optional: comma-separated emails that receive `administrator` on sign-in/bootstrap (matches Auth0 primary email)
# ADMIN_BOOTSTRAP_EMAILS=you@company.com,other@company.com

# Microsoft 365 / Graph + SharePoint — primary setup is Admin → Settings (stored in DB)
# Optional local/debug references:
# MS365_CLIENT_ID=            Application (client) ID
# MS365_CLIENT_SECRET=        Client secret
# MS365_TENANT_ID=            Directory (tenant) ID
# MS365_MAIL_FROM=            Mailbox UPN that sends mail (Graph sendMail)
# MS365_MAIL_TO=              Optional; consultation inbox (defaults to MAIL_FROM)
# MS365_SHAREPOINT_SITE_ID=
# MS365_RESUME_FOLDER_PATH=
# MS365_LOGO_FOLDER_PATH=
# MS365_JOB_ATTACHMENT_PATH=
