# Auth0 (v4 SDK)
AUTH0_SECRET=use-a-random-string-at-least-32-chars
AUTH0_DOMAIN=YOUR_DOMAIN.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
APP_BASE_URL=https://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/weir-here

# MS365 defaults (admin can override in DB)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_SHAREPOINT_SITE_ID=
MS365_RESUME_FOLDER_PATH=
MS365_LOGO_FOLDER_PATH=
MS365_JOB_ATTACHMENT_PATH=
